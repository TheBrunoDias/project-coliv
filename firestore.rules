rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidDisplayName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    function isValidName(name) {
      return name is string && name.trim().size() > 0 && name.size() <= 60;
    }

    function isValidInviteCode(code) {
      return code is string && code.matches('^[a-z0-9]{12}$');
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function housePath(houseId) {
      return /databases/$(database)/documents/houses/$(houseId);
    }

    function memberPath(houseId, uid) {
      return /databases/$(database)/documents/houses/$(houseId)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function isMember(houseId) {
      return isSignedIn() && exists(memberPath(houseId, request.auth.uid));
    }

    function isAdmin(houseId) {
      return isSignedIn() && get(housePath(houseId)).data.ownerId == request.auth.uid;
    }

    function isValidCurrency(house) {
      return !('currency' in house) || house.currency in ['EUR', 'BRL', 'USD', 'GBP'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Users ----------

    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'houseId', 'createdAt'])
        && request.resource.data.uid == uid
        && isValidDisplayName(request.resource.data.displayName)
        && request.resource.data.houseId == null
        && request.resource.data.createdAt == request.time;

      // houseId can stay the same, be cleared (leave / lazy cleanup), or be set from null
      // when the same batch creates the user's member document (create house / join).
      allow update: if isSelf(uid)
        && changedKeys().hasOnly(['displayName', 'photoURL', 'houseId'])
        && isValidDisplayName(request.resource.data.displayName)
        && (request.resource.data.houseId == resource.data.houseId
            || request.resource.data.houseId == null
            || (resource.data.houseId == null
                && request.resource.data.houseId is string
                && existsAfter(memberPath(request.resource.data.houseId, uid))));

      // Account deletion: the house must be left/deleted first
      allow delete: if isSelf(uid) && resource.data.houseId == null;
    }

    // ---------- Invites ----------

    // Lookup table for invite links: anyone signed in can resolve a code they know,
    // but nobody can list codes.
    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && isValidInviteCode(code)
        && request.resource.data.keys().hasOnly(['houseId', 'houseName', 'createdAt'])
        && getAfter(housePath(request.resource.data.houseId)).data.ownerId == request.auth.uid
        && getAfter(housePath(request.resource.data.houseId)).data.inviteCode == code
        && isValidName(request.resource.data.houseName)
        && request.resource.data.createdAt == request.time;

      // Keep houseName in sync when the house is renamed
      allow update: if isSignedIn()
        && changedKeys().hasOnly(['houseName'])
        && isValidName(request.resource.data.houseName)
        && get(housePath(resource.data.houseId)).data.ownerId == request.auth.uid;

      allow delete: if isSignedIn()
        && get(housePath(resource.data.houseId)).data.ownerId == request.auth.uid;
    }

    // ---------- Houses ----------

    match /houses/{houseId} {
      allow read: if isMember(houseId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['id', 'name', 'ownerId', 'inviteCode', 'currency', 'createdAt'])
        && request.resource.data.id == houseId
        && request.resource.data.ownerId == request.auth.uid
        && isValidName(request.resource.data.name)
        && isValidInviteCode(request.resource.data.inviteCode)
        && isValidCurrency(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(invitePath(request.resource.data.inviteCode)).data.houseId == houseId
        && existsAfter(memberPath(houseId, request.auth.uid));

      // Rename, change currency, or regenerate the invite code
      // (new invite created + old one deleted in the same batch)
      allow update: if isAdmin(houseId)
        && changedKeys().hasOnly(['name', 'inviteCode', 'currency'])
        && isValidName(request.resource.data.name)
        && isValidCurrency(request.resource.data)
        && (request.resource.data.inviteCode == resource.data.inviteCode
            || (isValidInviteCode(request.resource.data.inviteCode)
                && getAfter(invitePath(request.resource.data.inviteCode)).data.houseId == houseId
                && !existsAfter(invitePath(resource.data.inviteCode))));

      allow delete: if isAdmin(houseId);

      // ---------- Members ----------

      match /members/{memberId} {
        allow read: if isMember(houseId);

        // A user can only add themselves, while not in any house, and either
        // as the creator of a brand-new house or with the house's current invite code.
        allow create: if isSelf(memberId)
          && request.resource.data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'groupIds', 'joinedAt', 'inviteCode'])
          && request.resource.data.userId == memberId
          && isValidDisplayName(request.resource.data.displayName)
          && request.resource.data.groupIds == []
          && request.resource.data.joinedAt == request.time
          && get(userPath(memberId)).data.houseId == null
          && getAfter(userPath(memberId)).data.houseId == houseId
          && ((!exists(housePath(houseId))
                && getAfter(housePath(houseId)).data.ownerId == memberId)
              || (exists(housePath(houseId))
                && request.resource.data.inviteCode == get(housePath(houseId)).data.inviteCode));

        // Admin manages group membership; members can refresh their own display info
        allow update: if (isAdmin(houseId)
            && changedKeys().hasOnly(['groupIds'])
            && request.resource.data.groupIds is list)
          || (isSelf(memberId)
            && changedKeys().hasOnly(['displayName', 'photoURL'])
            && isValidDisplayName(request.resource.data.displayName));

        // Residents can leave; the admin can remove residents, and can only remove
        // themselves as part of deleting the house.
        allow delete: if isSignedIn()
          && ((isSelf(memberId) && !isAdmin(houseId))
              || (isAdmin(houseId)
                  && (memberId != request.auth.uid || !existsAfter(housePath(houseId)))));
      }

      // ---------- Groups ----------

      match /groups/{groupId} {
        allow read: if isMember(houseId);

        allow create: if isAdmin(houseId)
          && request.resource.data.keys().hasOnly(['id', 'name', 'createdAt'])
          && request.resource.data.id == groupId
          && isValidName(request.resource.data.name)
          && request.resource.data.createdAt == request.time;

        allow update: if isAdmin(houseId)
          && changedKeys().hasOnly(['name'])
          && isValidName(request.resource.data.name);

        allow delete: if isAdmin(houseId);
      }

      // ---------- Tasks ----------

      match /tasks/{taskId} {
        function isValidTask(task) {
          return task.keys().hasAll(['id', 'title', 'assigneeType', 'rotation', 'frequency', 'anchorDate', 'anchorIndex', 'createdBy', 'createdAt', 'updatedAt'])
            && task.keys().hasOnly(['id', 'title', 'description', 'assigneeType', 'rotation', 'frequency', 'interval', 'anchorDate', 'anchorIndex', 'createdBy', 'createdAt', 'updatedAt'])
            && task.id == taskId
            && task.title is string && task.title.trim().size() > 0 && task.title.size() <= 80
            && (!('description' in task) || (task.description is string && task.description.size() <= 500))
            && task.assigneeType in ['user', 'group']
            && isValidRotation(task);
        }

        function isValidRotation(task) {
          return task.rotation is list && task.rotation.size() <= 30
            && task.frequency in ['daily', 'weekly', 'biweekly', 'monthly']
            && (!('interval' in task) || (task.interval is int && task.interval >= 1 && task.interval <= 30))
            && task.anchorDate is timestamp
            && task.anchorIndex is int && task.anchorIndex >= 0
            && (task.rotation.size() == 0 || task.anchorIndex < task.rotation.size());
        }

        allow read: if isMember(houseId);

        allow create: if isAdmin(houseId)
          && isValidTask(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Admin edits anything but authorship. Any member may remove *themselves* from a
        // user rotation (used when leaving the house), re-anchoring the turn.
        allow update: if (isAdmin(houseId)
            && isValidTask(request.resource.data)
            && !changedKeys().hasAny(['id', 'createdBy', 'createdAt'])
            && request.resource.data.updatedAt == request.time)
          || (isMember(houseId)
            && resource.data.assigneeType == 'user'
            && request.auth.uid in resource.data.rotation
            && changedKeys().hasOnly(['rotation', 'anchorDate', 'anchorIndex', 'updatedAt'])
            && request.resource.data.rotation == resource.data.rotation.removeAll([request.auth.uid])
            && isValidRotation(request.resource.data)
            && request.resource.data.updatedAt == request.time);

        allow delete: if isAdmin(houseId);
      }

      // ---------- Purchases ----------

      // Shared expenses: whoever paid registers the purchase; it is split equally among the
      // `splitCount` residents living in the house at that moment.
      match /purchases/{purchaseId} {
        function isValidPurchase(purchase) {
          return purchase.keys().hasAll(['id', 'items', 'amountCents', 'date', 'paidBy', 'splitCount', 'createdAt'])
            && purchase.keys().hasOnly(['id', 'description', 'items', 'amountCents', 'date', 'paidBy', 'splitCount', 'createdAt', 'updatedAt'])
            && purchase.id == purchaseId
            && purchase.items is list && purchase.items.size() <= 30
            && (!('description' in purchase)
                || (purchase.description is string
                    && purchase.description.trim().size() > 0
                    && purchase.description.size() <= 200))
            // Needs a list of items, a description, or both
            && (purchase.items.size() > 0 || 'description' in purchase)
            && purchase.amountCents is int && purchase.amountCents > 0 && purchase.amountCents <= 100000000
            && purchase.date is timestamp
            && purchase.splitCount is int && purchase.splitCount >= 1 && purchase.splitCount <= 50;
        }

        function isPayerOrAdmin() {
          return resource.data.paidBy == request.auth.uid || isAdmin(houseId);
        }

        allow read: if isMember(houseId);

        allow create: if isMember(houseId)
          && isValidPurchase(request.resource.data)
          && request.resource.data.paidBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !('updatedAt' in request.resource.data);

        allow update: if isMember(houseId)
          && isPayerOrAdmin()
          && isValidPurchase(request.resource.data)
          && !changedKeys().hasAny(['id', 'paidBy', 'splitCount', 'createdAt'])
          && request.resource.data.updatedAt == request.time;

        allow delete: if isMember(houseId) && isPayerOrAdmin();
      }

      // Legacy shopping list (replaced by purchases); kept so old data can be deleted
      match /shopping_items/{itemId} {
        allow read: if isMember(houseId);
        allow delete: if isAdmin(houseId);
      }

      // ---------- Notice board ----------

      // House rules (isRule) and announcements: written by the admin, read by everyone.
      match /notice_board/{noticeId} {
        function isValidNotice(notice) {
          return notice.keys().hasAll(['id', 'title', 'content', 'isRule', 'createdBy', 'createdAt'])
            && notice.keys().hasOnly(['id', 'title', 'content', 'isRule', 'createdBy', 'createdAt', 'updatedAt'])
            && notice.id == noticeId
            && notice.title is string && notice.title.trim().size() > 0 && notice.title.size() <= 100
            && notice.content is string && notice.content.size() <= 2000
            && notice.isRule is bool;
        }

        allow read: if isMember(houseId);

        allow create: if isAdmin(houseId)
          && isValidNotice(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !('updatedAt' in request.resource.data);

        allow update: if isAdmin(houseId)
          && isValidNotice(request.resource.data)
          && !changedKeys().hasAny(['id', 'createdBy', 'createdAt'])
          && request.resource.data.updatedAt == request.time;

        allow delete: if isAdmin(houseId);
      }
    }
  }
}
